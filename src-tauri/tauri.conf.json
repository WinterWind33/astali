{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astali",
  "version": "1.7.0",
  "identifier": "com.astali.kanban",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Astali",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "backgroundColor": "#0f1115"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright (c) 2026 Andrea Ballestrazzi",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "template": "./windows/installer.nsi",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0RDJDQ0MyNEI5QjczNTMKUldSVGM1dEx3c3pTRkIwb1hKL1VGcWhNVzdsRW1XNlVoSGVtMDJkcGtHZ3dTbXVGbm1LTEYwTXoK",
      "endpoints": [
        "https://github.com/WinterWind33/astali/releases/latest/download/latest.json"
      ]
    }
  }
}
